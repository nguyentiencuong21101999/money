{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    // File test chạy thẳng bằng `node --experimental-strip-types` nên phải import kèm đuôi .ts
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // `mobile/` là app React Native, có tsconfig riêng và lib khác hẳn (react-native
  // thay vì dom). Không loại ra thì `include: **/*.ts` nuốt luôn nó và `tsc --noEmit`
  // của web báo cả đống lỗi không liên quan.
  "exclude": ["node_modules", "mobile"]
}
