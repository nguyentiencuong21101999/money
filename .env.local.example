# Copy file này thành `.env.local` rồi điền giá trị thật.
# Sau khi sửa .env.local phải tắt và chạy lại `npm run dev`.

# --- Gemini (đọc ảnh bill) — lấy ở https://aistudio.google.com/apikey ---
# Chỉ dùng phía server, KHÔNG có tiền tố NEXT_PUBLIC_ nên trình duyệt không thấy được.
GEMINI_API_KEY=

# (Không bắt buộc) Chuỗi model dự phòng, cách nhau bằng dấu phẩy, xếp từ ưu tiên cao xuống thấp.
# Mỗi model có quota free riêng nên hết con này sẽ tự nhảy sang con kế tiếp.
# Bỏ trống = dùng mặc định: gemini-3.5-flash,gemini-2.5-flash,gemini-3.5-flash-lite,gemini-2.5-flash-lite
# Chạy `npm run check-models` để xem key của bạn gọi được những model nào.
# GEMINI_MODELS=

# (Không bắt buộc, NÊN đặt khi deploy lên mạng) Danh sách email được phép quét ảnh,
# cách nhau bằng dấu phẩy. Bỏ trống = bất kỳ ai đăng nhập Google cũng quét được,
# nghĩa là người lạ có thể đốt hết quota Gemini của bạn.
# ALLOWED_EMAILS=ban@gmail.com

# --- Firebase — Console > ⚙️ Project settings > Your apps > Web app ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Trang quản lý /manager ---
# Email được vào trang quản lý, cách nhau dấu phẩy. Bỏ trống = dùng mặc định
# trong src/lib/admin.ts. ĐỔI Ở ĐÂY THÌ PHẢI ĐỔI CẢ hàm isAdmin() trong
# firestore.rules — đó mới là chỗ chặn thật, biến này chỉ ẩn/hiện giao diện.
NEXT_PUBLIC_ADMIN_EMAILS=

# (Chỉ cần khi muốn GỬI thông báo) Service account JSON, dán nguyên một dòng.
# Console > ⚙️ Project settings > tab Service accounts > Generate new private key.
# Chỉ dùng phía server. TUYỆT ĐỐI không thêm tiền tố NEXT_PUBLIC_ — khoá này mở
# được toàn bộ database, lộ ra trình duyệt là mất sạch dữ liệu.
FIREBASE_SERVICE_ACCOUNT=

# (Không bắt buộc) Thông báo đẩy. Console > ⚙️ Project settings > tab Cloud Messaging
# > Web Push certificates > Generate key pair, rồi dán chuỗi "Key pair" vào đây.
# Bỏ trống = app giấu luôn phần thông báo, mọi thứ khác chạy bình thường.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- Thư viện ảnh /anh (Google Drive) — độc lập với sổ tiền ---
# Bỏ trống cả 4 biến = trang /anh hiện lời nhắc cấu hình, phần sổ tiền không ảnh hưởng.
#
# Cách lấy: chạy `npm run drive-auth`. Chưa có CLIENT_ID/SECRET thì script sẽ in
# ra đúng 5 bước cần làm trong Google Cloud Console.
#
# Chỉ dùng phía server. TUYỆT ĐỐI không thêm tiền tố NEXT_PUBLIC_ — bộ ba
# client_secret + refresh_token mở được quyền ghi vào Drive của bạn.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=

# Refresh token của CHÍNH tài khoản sẽ chứa ảnh. Không dùng service account được:
# service account không có quota lưu trữ Drive, upload vào là storageQuotaExceeded.
#
# App còn ở trạng thái Testing thì token này CHẾT SAU 7 NGÀY. Vào
# console.cloud.google.com/auth/audience > Publish app để nó không hết hạn nữa.
GOOGLE_DRIVE_REFRESH_TOKEN=

# Thư mục chứa ảnh, do `npm run drive-auth` tự tạo và in ra.
# Bỏ trống = ảnh rơi thẳng vào gốc My Drive, lẫn với mọi thứ khác.
GOOGLE_DRIVE_FOLDER_ID=
