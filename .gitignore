# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# file mẫu không chứa key thật nên vẫn commit được
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# App React Native (mobile/): commit SOURCE, bỏ phần build/generated + secret.
mobile/node_modules
mobile/.expo
# ios/ và android/ do `expo prebuild` sinh ra từ app.json — dựng lại được bất cứ
# lúc nào, commit vào chỉ tổ xung đột (và nặng). Sửa tay trong ios/ thì dùng
# config plugin thay vì bỏ dòng này.
mobile/ios
mobile/android
# Secret của app iOS — không commit (giống chính sách .env*).
mobile/GoogleService-Info.plist
mobile/.env

# Khoá Firebase của app iOS — không commit (giống chính sách .env*).
GoogleService-Info.plist
