# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# file mẫu không chứa key thật nên vẫn commit được
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# App React Native để RIÊNG khỏi repo web (quản lý bằng repo/nơi khác). Repo này
# chỉ là bản web (deploy Vercel). Mobile vẫn nằm cùng thư mục trên đĩa vì nó đọc
# code dùng chung `../src/lib/call.ts` qua metro — chỉ là không track ở git web.
/mobile/

# File phụ, không thuộc bản web
/logos.png
/docs/
/.vercelignore

# Khoá Firebase của app iOS — không commit (giống chính sách .env*).
GoogleService-Info.plist
