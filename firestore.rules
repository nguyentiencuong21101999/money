rules_version = '2';

// Dán toàn bộ file này vào Firebase Console > Firestore Database > tab Rules > Publish.
// Nguyên tắc: mỗi người chỉ đọc/ghi được đúng dữ liệu của chính mình.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /transactions/{txId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.amount is number
          && request.resource.data.amount >= 0
          && request.resource.data.type in ['income', 'expense']
          && request.resource.data.month is string
          && request.resource.data.date is string
          // chặn ảnh quá to làm phình document (giới hạn cứng của Firestore là 1MB/doc)
          && (!('thumbnail' in request.resource.data)
              || request.resource.data.thumbnail.size() < 400000);
      }

      // Token nhận thông báo đẩy, mỗi máy một doc, id chính là token.
      // Subcollection KHÔNG tự thừa kế rule của /users/{userId} ở trên nên
      // thiếu block này là mọi thao tác ghi token đều bị từ chối.
      match /devices/{deviceId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.token is string;
      }

      // Thông báo do máy chủ ghi (Admin SDK bỏ qua rules), phía trình duyệt chỉ
      // được đọc và đánh dấu đã đọc — không được tự tạo hay xoá thông báo.
      match /notifications/{notiId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
          && request.resource.data.isRead is bool;
      }

      match /budgets/{month} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.limit is number
          && request.resource.data.limit >= 0;
      }
    }

    // Mọi thứ khác: cấm.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
